# ==============================================================================
# FOREVER IT INSTITUTE MANAGEMENT API - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Security & JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Initial Admin Seeding (Used only during npm run seed)
INITIAL_ADMIN_EMAIL=admin@foreveritbd.com
INITIAL_ADMIN_PASSWORD=ChangeMeAdmin123!
INITIAL_ADMIN_NAME=System Administrator

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Choose either Option A (DATABASE_URL) OR Option B (Individual fields).
# Precedence: If DATABASE_URL is non-empty, it takes precedence over Option B.

# OPTION A: Connection String (e.g., Supabase / Managed PostgreSQL)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# OPTION B: Individual Fields (e.g., cPanel PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cpaneluser_fituser
DB_PASSWORD=your_secure_db_password
DB_DATABASE=cpaneluser_forever_it_db

# SSL Configuration:
# - auto: automatically detects SSL (enabled for Supabase/remote hosts/production)
# - true: force SSL on
# - false: disable SSL (common for localhost or internal cPanel connections)
DB_SSL=auto

# Reject Unauthorized SSL Certificates (true for strict validation; false if self-signed)
DB_SSL_REJECT_UNAUTHORIZED=true

# TypeORM Behavior (Keep synchronize false in production; use migrations)
DB_SYNCHRONIZE=false
DB_LOGGING=false
