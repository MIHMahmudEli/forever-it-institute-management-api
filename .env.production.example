# ==============================================================================
# PRODUCTION ENVIRONMENT EXAMPLE (CPANEL / HOSTING POSTGRESQL)
# Copy to .env in your production hosting environment
# ==============================================================================

NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=https://foreveritbd.com,https://app.foreveritbd.com

# Use a strong, cryptographically secure 64-character random string in production
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_TO_A_SECURE_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=1d

# Production initial admin credentials (used only if running seeds)
INITIAL_ADMIN_EMAIL=admin@foreveritbd.com
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_PASSWORD!
INITIAL_ADMIN_NAME=Institute Administrator

# cPanel PostgreSQL usually connects via localhost or local socket without SSL,
# or via dedicated database server hostname:
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=foreverit_db_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_DATABASE=foreverit_institute_db

# On local cPanel internal server, SSL is typically disabled (false).
# If connecting to an external or remote PostgreSQL server, set to true.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Strictly disable auto-synchronize in production (use migrations)
DB_SYNCHRONIZE=false
DB_LOGGING=false
