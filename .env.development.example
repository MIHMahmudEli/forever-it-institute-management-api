# ==============================================================================
# DEVELOPMENT ENVIRONMENT EXAMPLE (SUPABASE POSTGRESQL)
# Copy to .env for local development
# ==============================================================================

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=dev_super_secret_jwt_key_forever_it_institute_2026
JWT_EXPIRES_IN=7d

INITIAL_ADMIN_EMAIL=admin@foreveritbd.com
INITIAL_ADMIN_PASSWORD=Admin123456!
INITIAL_ADMIN_NAME=Super Admin

# Supabase PostgreSQL Connection String (Session pooler port 5432 or Transaction pooler port 6543)
DATABASE_URL=postgresql://postgres.example_project_ref:ExamplePassword123@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Alternatively individual fields can be left blank when DATABASE_URL is used:
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Supabase requires SSL; auto or true enables it with appropriate certificate handling
DB_SSL=auto
DB_SSL_REJECT_UNAUTHORIZED=false

DB_SYNCHRONIZE=false
DB_LOGGING=true
